@inject IViewLocalizer Localizer
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    bool IsActive(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    var metaTitle = ViewData["MetaTitle"] as string ?? Localizer["Meta_Title"].Value;
    var metaDescription = ViewData["MetaDescription"] as string ?? Localizer["Meta_Description"].Value;
    var pageUrl = $"https://kunev.dev{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="@metaDescription" />
    <meta name="author" content="Явор Кънев" />
    <title>@metaTitle</title>
    <link rel="canonical" href="@pageUrl" />
    <!-- Open Graph (Viber/Facebook споделяне) -->
    <meta property="og:title" content="@metaTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:image" content="https://kunev.dev/assets/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="kunev.dev — учител · изследовател · разработчик" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@metaTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <!-- Favicon — знак „отворена книга" (handoff: wwwroot/assets/logo) -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta name="theme-color" content="#F2EDE1" />
    <!-- Google Fonts — Fraunces (display), Inter (body), Instrument Serif (italic accents), JetBrains Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true" />
    <!-- Redesign overlay -->
    <link href="~/css/redesign.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Person",
        "name": "Явор Кънев",
        "url": "https://kunev.dev",
        "email": "yavor@@kunev.dev",
        "telephone": "+359897942126",
        "jobTitle": "Учител по програмиране · Докторант в ИМИ–БАН",
        "description": "Учител, докторант и разработчик — обучения, одити и консултации за смислено използване на изкуствен интелект в училище.",
        "sameAs": [
            "https://github.com/PetrovKunev",
            "https://linkedin.com/in/yavor-kunev"
        ],
        "knowsAbout": ["Изкуствен интелект в образованието", "Интелигентни системи за обучение", "Обучение по програмиране", "ASP.NET Core", "C#"]
    }
    </script>
</head>
<body id="page-top">
    <!-- Navigation-->
    <nav id="mainNav" class="navbar navbar-expand-lg py-3">
        <div class="container px-3 px-lg-5">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <svg class="brand-mark" viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
                    <path d="M60 66 L26 34 M60 66 L60 20 M60 66 L94 34" stroke="currentColor" stroke-width="6.5" />
                    <path d="M60 68 L16 58 L16 88 L60 98 Z" fill="#A8E1D5" />
                    <path d="M60 68 L16 58 L16 88 L60 98 M60 68 L104 58 L104 88 L60 98 M60 68 V98" stroke="currentColor" stroke-width="6.5" stroke-linejoin="round" />
                    <circle cx="26" cy="34" r="8" fill="currentColor" />
                    <circle cx="60" cy="20" r="8" fill="currentColor" />
                    <circle cx="94" cy="34" r="8" fill="currentColor" />
                </svg>
                <span class="brand-word">kunev<em>.dev</em></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Index") ? "active" : "")" asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Consulting") ? "active" : "")" asp-controller="Home" asp-action="Consulting">@Localizer["Nav_Consulting"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Projects") ? "active" : "")" asp-controller="Home" asp-action="Projects">@Localizer["Nav_Projects"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Research") ? "active" : "")" asp-controller="Home" asp-action="Research">@Localizer["Nav_Research"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Writing") || IsActive("KnowledgeRepresentation") ? "active" : "")" asp-controller="Home" asp-action="Writing">@Localizer["Nav_Writing"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("About") ? "active" : "")" asp-controller="Home" asp-action="About">@Localizer["Nav_About"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Contact") ? "active" : "")" asp-controller="Home" asp-action="Contact">@Localizer["Nav_Contact"]</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main content area -->
    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-auto">
        <div class="container px-3 px-lg-5">
            <div class="footer-running">
                <span>№ 01 · Summer 2026</span>
                <span class="fr-mid">Yavor Kunev · Sofia, BG</span>
                <span>kunev.dev</span>
            </div>
            <div class="row align-items-center justify-content-between flex-column flex-sm-row g-3">
                <div class="col-auto"><div class="m-0">&copy; 2025–2026 · kunev.dev</div></div>
                <div class="col-auto d-flex align-items-center flex-wrap gap-3">
                    <a class="text-decoration-none" href="tel:+359897942126"><i class="bi bi-telephone me-1" aria-hidden="true"></i>+359 89 79 42 126</a>
                    <a class="text-decoration-none" href="viber://chat?number=%2B359897942126" aria-label="Viber"><i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Viber</a>
                    <a class="text-decoration-none" href="mailto:yavor@kunev.dev">yavor@kunev.dev</a>
                    <div class="social-links">
                        <a href="https://linkedin.com/in/yavor-kunev" target="_blank" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://github.com/PetrovKunev" target="_blank" aria-label="GitHub"><i class="bi bi-github"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="~/js/scripts.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
