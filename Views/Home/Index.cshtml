@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = "Yavor Kunev";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 01 · kunev.dev / home</span>
            <span class="rh-right">@Localizer["RH_Right"]</span>
        </div>

        <div class="hero-grid">
            <div>
                <div class="hero-eyebrow">@Localizer["Hero_Label"]</div>
                <h1 class="hero-headline">
                    @Localizer["Hero_Headline_1"]
                    <span class="hl">@Localizer["Hero_Headline_2"]</span>
                </h1>
                <p class="hero-subheadline">@Localizer["Hero_Subheadline"]</p>
                <div class="d-flex gap-3 flex-wrap hero-buttons mb-4">
                    <a class="btn-accent" asp-controller="Home" asp-action="Research">
                        @Localizer["Hero_CTA_Research"] <span aria-hidden="true">→</span>
                    </a>
                    <a class="btn-outline-light-custom" asp-controller="Home" asp-action="Projects">@Localizer["Hero_CTA_Work"]</a>
                </div>
                <p class="hero-credibility">@Localizer["Hero_Credibility_Before"]<a href="https://codegrade.kunev.dev/" target="_blank" rel="noopener">CodeGrade</a>@Localizer["Hero_Credibility_After"]</p>
            </div>

            <aside class="hero-rail">
                <div class="rail-group">
                    <span class="rail-k">@Localizer["Rail_Role"]</span>
                    <span class="rail-v">@Html.Raw(Localizer["Rail_Role_Value"].Value)</span>
                </div>
                <div class="rail-group">
                    <span class="rail-k">@Localizer["Rail_Field"]</span>
                    <span class="rail-v">@Localizer["Rail_Field_Value"]</span>
                </div>
                <div class="rail-group">
                    <span class="rail-k">@Localizer["Rail_Creator"]</span>
                    <span class="rail-v">@Localizer["Rail_Creator_Value"]</span>
                </div>
                <div class="rail-group">
                    <span class="rail-k">@Localizer["Rail_Based"]</span>
                    <span class="rail-v">@Localizer["Rail_Based_Value"]</span>
                </div>
            </aside>
        </div>
    </div>
</section>

<!-- About Section (inline) -->
<section class="about-section">
    <div class="container px-3 px-lg-5">
        <div class="row">
            <div class="col-lg-9">
                <div class="section-label">@Localizer["About_Label"]</div>
                <h2>@Localizer["About_Title"]</h2>
                <p class="about-text">@Localizer["About_P1"]</p>
                <p class="about-text">@Localizer["About_P2"]</p>
                <p class="about-text">@Localizer["About_P3"]</p>
                <div class="social-links mt-4">
                    <a href="https://github.com/PetrovKunev" target="_blank" aria-label="GitHub"><i class="bi bi-github"></i></a>
                    <a href="https://linkedin.com/in/yavor-kunev" target="_blank" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="mailto:yavor@kunev.dev" aria-label="Email"><i class="bi bi-envelope"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>
