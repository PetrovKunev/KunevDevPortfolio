@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;
}

<div class="container px-3 px-lg-5 my-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bolder mb-0">
            <span class="text-gradient d-inline">@Localizer["Page_Title"]</span>
        </h1>
        <p class="lead fw-light mb-4">@Localizer["Page_Subtitle"]</p>
    </div>
    <div class="row gx-5 justify-content-center">
        <div class="col-lg-11 col-xl-9 col-xxl-8">

            <!-- Experience Section-->
            <section>
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h2 class="text-primary fw-bolder mb-0">@Localizer["Experience_Title"]</h2>
                    <!-- Download resume button -->
                    <a class="btn btn-primary px-4 py-3" href="~/assets/Yavor_Petrov_Resume.pdf" target="_blank">
                        <div class="d-inline-block bi bi-download me-2"></div>
                        @Localizer["Download_Resume"]
                    </a>
                </div>

                <!-- Experience Card 1-->
                <div class="card shadow border-0 rounded-4 mb-5">
                    <div class="card-body p-5">
                        <div class="row align-items-center gx-5">
                            <div class="col text-center text-lg-start mb-4 mb-lg-0">
                                <div class="bg-light p-4 rounded-4">
                                    <div class="text-primary fw-bolder mb-2">@Localizer["Exp1_Period"]</div>
                                    <div class="small fw-bolder">@Localizer["Exp1_Role"]</div>
                                    <div class="small text-muted">@Localizer["Exp1_Company"]</div>
                                    <div class="small text-muted">@Localizer["Exp1_Location"]</div>
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div>@Localizer["Exp1_Desc"]</div>
                                <div class="mt-3">
                                    <span class="badge bg-primary me-2">ASP.NET Core</span>
                                    <span class="badge bg-primary me-2">Entity Framework</span>
                                    <span class="badge bg-primary me-2">Bootstrap</span>
                                    <span class="badge bg-primary me-2">SQL Server</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Experience Card 2-->
                <div class="card shadow border-0 rounded-4 mb-5">
                    <div class="card-body p-5">
                        <div class="row align-items-center gx-5">
                            <div class="col text-center text-lg-start mb-4 mb-lg-0">
                                <div class="bg-light p-4 rounded-4">
                                    <div class="text-primary fw-bolder mb-2">@Localizer["Exp2_Period"]</div>
                                    <div class="small fw-bolder">@Localizer["Exp2_Role"]</div>
                                    <div class="small text-muted">@Localizer["Exp2_Company"]</div>
                                    <div class="small text-muted">@Localizer["Exp2_Location"]</div>
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div>@Localizer["Exp2_Desc"]</div>
                                <div class="mt-3">
                                    <span class="badge bg-secondary me-2">Professional Qualification</span>
                                    <span class="badge bg-secondary me-2">450+ Training Hours</span>
                                    <span class="badge bg-secondary me-2">Excellent Performance</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Education Section-->
            <section>
                <h2 class="text-secondary fw-bolder mb-4">@Localizer["Education_Title"]</h2>

                <!-- Education Card 1-->
                <div class="card shadow border-0 rounded-4 mb-5">
                    <div class="card-body p-5">
                        <div class="row align-items-center gx-5">
                            <div class="col text-center text-lg-start mb-4 mb-lg-0">
                                <div class="bg-light p-4 rounded-4">
                                    <div class="text-secondary fw-bolder mb-2">@Localizer["Edu1_Period"]</div>
                                    <div class="mb-2">
                                        <div class="small fw-bolder">@Localizer["Edu1_Institution"]</div>
                                        <div class="small text-muted">@Localizer["Edu1_Location"]</div>
                                    </div>
                                    <div class="fst-italic">
                                        <div class="small text-muted">@Localizer["Edu1_Type"]</div>
                                        <div class="small text-muted">@Localizer["Edu1_Program"]</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div>@Localizer["Edu1_Desc"]</div>
                                <div class="mt-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-outline-secondary">C# Advanced (6.00)</span>
                                        <span class="badge bg-outline-secondary">ASP.NET Core (6.00)</span>
                                        <span class="badge bg-outline-secondary">Entity Framework (6.00)</span>
                                        <span class="badge bg-outline-secondary">MS SQL (6.00)</span>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#diploma-details">
                                        <i class="bi bi-award me-1"></i>@Localizer["Edu1_ViewDetails"]
                                    </button>
                                </div>
                                <div class="collapse mt-3" id="diploma-details">
                                    <div class="card card-body bg-light">
                                        <h6 class="fw-bold mb-3">@Localizer["Edu1_CoursesTitle"]</h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <ul class="small mb-2">
                                                    <li>Programming Fundamentals (56h) - 5.55</li>
                                                    <li>C# Advanced (38h) - 6.00</li>
                                                    <li>C# OOP (30h) - 6.00</li>
                                                    <li>ASP.NET Fundamentals (24h) - 6.00</li>
                                                    <li>ASP.NET Advanced (40h) - 5.69</li>
                                                    <li>Entity Framework Core (33h) - 6.00</li>
                                                </ul>
                                            </div>
                                            <div class="col-md-6">
                                                <ul class="small mb-2">
                                                    <li>Programming Basics (17h) - 6.00</li>
                                                    <li>HTML & CSS (15h) - 6.00</li>
                                                    <li>MS SQL (30h) - 6.00</li>
                                                    <li>Software Engineering and DevOps (24h) - 6.00</li>
                                                    <li>Introduction to Cyber Security (12h) - 6.00</li>
                                                </ul>
                                            </div>
                                        </div>
                                        <p class="small mb-0 text-muted"><strong>@Localizer["Edu1_Total"]</strong></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Divider-->
            <div class="pb-5"></div>

            <!-- Skills Section-->
            <section>
                <div class="card shadow border-0 rounded-4 mb-5">
                    <div class="card-body p-5">
                        <!-- Backend Technologies-->
                        <div class="mb-5">
                            <div class="d-flex align-items-center mb-4">
                                <div class="feature bg-primary bg-gradient-primary-to-secondary text-white rounded-3 me-3">
                                    <i class="bi bi-server"></i>
                                </div>
                                <h3 class="fw-bolder mb-0">
                                    <span class="text-gradient d-inline">@Localizer["Skills_Backend"]</span>
                                </h3>
                            </div>
                            <div class="row row-cols-1 row-cols-md-3 mb-4">
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">ASP.NET Core</div>
                                </div>
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">C#</div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Entity Framework</div>
                                </div>
                            </div>
                            <div class="row row-cols-1 row-cols-md-3">
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">SQL Server</div>
                                </div>
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Identity Framework</div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Web APIs</div>
                                </div>
                            </div>
                        </div>

                        <!-- Frontend Technologies-->
                        <div class="mb-5">
                            <div class="d-flex align-items-center mb-4">
                                <div class="feature bg-secondary bg-gradient-secondary-to-primary text-white rounded-3 me-3">
                                    <i class="bi bi-palette"></i>
                                </div>
                                <h3 class="fw-bolder mb-0">
                                    <span class="text-gradient d-inline">@Localizer["Skills_Frontend"]</span>
                                </h3>
                            </div>
                            <div class="row row-cols-1 row-cols-md-3 mb-4">
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">HTML5</div>
                                </div>
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">CSS3</div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">JavaScript</div>
                                </div>
                            </div>
                            <div class="row row-cols-1 row-cols-md-3">
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Bootstrap</div>
                                </div>
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Razor Pages</div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Responsive Design</div>
                                </div>
                            </div>
                        </div>

                        <!-- Tools & Methodologies -->
                        <div class="mb-0">
                            <div class="d-flex align-items-center mb-4">
                                <div class="feature bg-primary bg-gradient-primary-to-secondary text-white rounded-3 me-3">
                                    <i class="bi bi-tools"></i>
                                </div>
                                <h3 class="fw-bolder mb-0">
                                    <span class="text-gradient d-inline">@Localizer["Skills_Tools"]</span>
                                </h3>
                            </div>
                            <div class="row row-cols-1 row-cols-md-3 mb-4">
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Git & GitHub</div>
                                </div>
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Visual Studio</div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">xUnit Testing</div>
                                </div>
                            </div>
                            <div class="row row-cols-1 row-cols-md-3">
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Dependency Injection</div>
                                </div>
                                <div class="col mb-4 mb-md-0">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Clean Architecture</div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center bg-light rounded-4 p-3 h-100">Agile Development</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Key Projects Section -->
            <section>
                <div class="card border-0 rounded-4 mb-5" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="card-body p-5">
                        <h3 class="fw-bolder mb-4 text-center">
                            <span class="text-gradient d-inline">@Localizer["Achievements_Title"]</span>
                        </h3>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-3 mt-1"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1">@Localizer["Achievement1_Title"]</h6>
                                        <p class="small mb-0">@Localizer["Achievement1_Desc"]</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-3 mt-1"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1">@Localizer["Achievement2_Title"]</h6>
                                        <p class="small mb-0">@Localizer["Achievement2_Desc"]</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-3 mt-1"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1">@Localizer["Achievement3_Title"]</h6>
                                        <p class="small mb-0">@Localizer["Achievement3_Desc"]</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-3 mt-1"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1">@Localizer["Achievement4_Title"]</h6>
                                        <p class="small mb-0">@Localizer["Achievement4_Desc"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<!-- Custom Styles -->
<style>
    .text-gradient {
        background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .bg-gradient-primary-to-secondary {
        background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);
    }

    .bg-gradient-secondary-to-primary {
        background: linear-gradient(135deg, var(--bs-secondary) 0%, var(--bs-primary) 100%);
    }

    .feature {
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
    }

    .bg-outline-secondary {
        background-color: transparent;
        border: 1px solid var(--bs-secondary);
        color: var(--bs-secondary);
    }
</style>
