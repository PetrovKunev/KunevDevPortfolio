@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;
}

<section class="section-dark contact-section">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 06 · kunev.dev / contact</span>
            <span class="rh-right">Reach out</span>
        </div>

        <div class="row justify-content-start">
            <div class="col-lg-10">
                <div class="mb-5">
                    <div class="section-label">@Localizer["Page_Label"]</div>
                    <h1 class="section-heading">@Localizer["Page_Title"]</h1>
                    <p class="section-subtitle">@Localizer["Page_Subtitle"]</p>
                </div>

                <div class="row g-3 mb-5">
                    <div class="col-md-4">
                        <div class="contact-info-card">
                            <i class="bi bi-envelope"></i>
                            <h6>@Localizer["Other_Email"]</h6>
                            <p><a href="mailto:yavor@kunev.dev">yavor@kunev.dev</a></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-info-card">
                            <i class="bi bi-github"></i>
                            <h6>@Localizer["Other_GitHub"]</h6>
                            <p><a href="https://github.com/PetrovKunev" target="_blank">@Localizer["Other_GitHub_Link"]</a></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-info-card">
                            <i class="bi bi-linkedin"></i>
                            <h6>LinkedIn</h6>
                            <p><a href="https://linkedin.com/in/yavor-kunev" target="_blank">yavor-kunev</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
