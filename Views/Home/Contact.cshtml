@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;

    var phoneDisplay = "+359 89 79 42 126";
    var phoneHref = "tel:+359897942126";
    var viberHref = "viber://chat?number=%2B359897942126";
}

<section class="section-dark contact-section">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 06 · kunev.dev / contact</span>
            <span class="rh-right">@Localizer["RH_Right"]</span>
        </div>

        <div class="row justify-content-start">
            <div class="col-lg-10">
                <div class="mb-5">
                    <div class="section-label">@Localizer["Page_Label"]</div>
                    <h1 class="section-heading">@Localizer["Page_Title"]</h1>
                    <p class="section-subtitle">@Localizer["Page_Subtitle"]</p>
                </div>

                <div class="booking-cta">
                    <div class="booking-kicker">@Localizer["Call_Kicker"]</div>
                    <h2>@Localizer["Call_Title"]</h2>
                    <p>@Localizer["Call_Text"]</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a class="btn-accent d-inline-flex" href="@phoneHref">
                            <i class="bi bi-telephone me-2" aria-hidden="true"></i>@phoneDisplay
                        </a>
                        <a class="btn-outline-light-custom d-inline-flex" href="@viberHref">
                            <i class="bi bi-chat-dots me-2" aria-hidden="true"></i>@Localizer["Call_Viber"]
                        </a>
                    </div>
                </div>

                <div class="section-label mb-3">@Localizer["Ways"]</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="contact-info-card">
                            <i class="bi bi-telephone"></i>
                            <h6>@Localizer["Way_Phone"]</h6>
                            <p><a href="@phoneHref">@phoneDisplay</a></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-info-card">
                            <i class="bi bi-chat-dots"></i>
                            <h6>Viber</h6>
                            <p><a href="@viberHref">@Localizer["Way_Viber_Link"]</a></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-info-card">
                            <i class="bi bi-envelope"></i>
                            <h6>@Localizer["Way_Email"]</h6>
                            <p><a href="mailto:yavor@kunev.dev">yavor@kunev.dev</a></p>
                        </div>
                    </div>
                </div>

                <p class="mb-5">
                    <span class="section-label me-2">@Localizer["Profiles"]</span>
                    <a class="text-decoration-none me-3" href="https://linkedin.com/in/yavor-kunev" target="_blank" rel="noopener"><i class="bi bi-linkedin me-1" aria-hidden="true"></i>LinkedIn</a>
                    <a class="text-decoration-none" href="https://github.com/PetrovKunev" target="_blank" rel="noopener"><i class="bi bi-github me-1" aria-hidden="true"></i>GitHub</a>
                </p>
            </div>
        </div>
    </div>
</section>
