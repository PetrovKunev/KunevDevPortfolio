@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;
}

<section class="section-dark">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 04 · kunev.dev / proekti</span>
            <span class="rh-right">@Localizer["RH_Right"]</span>
        </div>

        <div class="row mb-5">
            <div class="col-lg-9">
                <div class="section-label">@Localizer["Page_Label"]</div>
                <h1 class="section-heading">@Localizer["Page_Title"]</h1>
                <p class="section-subtitle">@Localizer["Page_Subtitle"]</p>
            </div>
        </div>

        <!-- ═══ Case study 1: SchoolSelect ═══ -->
        <div class="featured-project-card">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <div class="featured-status"><i class="bi bi-circle-fill"></i> @Localizer["Status_Production"]</div>
                    <h2 class="featured-title"><em>SchoolSelect</em>.net</h2>
                    <p class="featured-tagline">@Localizer["SchoolSelect_Tagline"]</p>

                    <div class="featured-narrative">
                        <div class="featured-narrative-row">
                            <div class="narrative-label">@Localizer["Label_Problem"]</div>
                            <p class="narrative-text">@Localizer["SchoolSelect_Problem"]</p>
                        </div>
                        <div class="featured-narrative-divider"></div>
                        <div class="featured-narrative-row">
                            <div class="narrative-label">@Localizer["Label_Solution"]</div>
                            <p class="narrative-text">@Localizer["SchoolSelect_Solution"]</p>
                        </div>
                        <div class="featured-narrative-divider"></div>
                        <div class="featured-narrative-row">
                            <div class="narrative-label">@Localizer["Label_Result"]</div>
                            <p class="narrative-text">@Localizer["SchoolSelect_Result"]</p>
                        </div>
                    </div>

                    <a href="https://schoolselect.net" target="_blank" rel="noopener" class="btn-accent d-inline-flex mt-3">
                        @Localizer["SchoolSelect_CTA"] <span aria-hidden="true">→</span>
                    </a>
                </div>
                <div class="col-lg-5">
                    <div class="featured-meta">
                        <div class="featured-stats">
                            <div class="featured-stat">
                                <div class="featured-stat-number"><em>150+</em></div>
                                <div class="featured-stat-label">@Localizer["SchoolSelect_Stat_Users"]</div>
                            </div>
                        </div>
                        <div class="project-tech mt-4" style="padding: 1rem 0 0; border-top: 1px solid var(--kd-rule);">
                            <span>ASP.NET Core</span>
                            <span>EF Core</span>
                            <span>SQL Server</span>
                            <span>Bootstrap</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ Case study 2: CodeGrade ═══ -->
        <div class="featured-project-card">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <div class="featured-status"><i class="bi bi-circle-fill"></i> @Localizer["Status_Development"]</div>
                    <h2 class="featured-title"><em>CodeGrade</em></h2>
                    <p class="featured-tagline">@Localizer["CodeGrade_Tagline"]</p>

                    <div class="featured-narrative">
                        <div class="featured-narrative-row">
                            <div class="narrative-label">@Localizer["Label_Problem"]</div>
                            <p class="narrative-text">@Localizer["CodeGrade_Problem"]</p>
                        </div>
                        <div class="featured-narrative-divider"></div>
                        <div class="featured-narrative-row">
                            <div class="narrative-label">@Localizer["Label_Solution"]</div>
                            <p class="narrative-text">@Localizer["CodeGrade_Solution"]</p>
                        </div>
                        <div class="featured-narrative-divider"></div>
                        <div class="featured-narrative-row">
                            <div class="narrative-label">@Localizer["Label_Result"]</div>
                            <p class="narrative-text">@Localizer["CodeGrade_Result"]</p>
                        </div>
                    </div>

                    <a href="https://codegrade.kunev.dev/" target="_blank" rel="noopener" class="btn-accent d-inline-flex mt-3">
                        @Localizer["CodeGrade_CTA"] <span aria-hidden="true">→</span>
                    </a>
                </div>
                <div class="col-lg-5">
                    <div class="featured-meta">
                        <div class="project-tech mt-4" style="padding: 1rem 0 0; border-top: 1px solid var(--kd-rule);">
                            <span>ASP.NET Core</span>
                            <span>MS SQL</span>
                            <span>Judge0</span>
                            <span>Tailwind</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ Още образователни инструменти ═══ -->
        <div class="projects-section">
            <div class="projects-section-heading" data-num="01 / Инструменти">
                <h2>@Localizer["Section_More_Title"]</h2>
                <p>@Localizer["Section_More_Subtitle"]</p>
            </div>
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="project-card-new">
                        <h3><em>Algorithm</em> Visualizer</h3>
                        <p class="project-desc">@Localizer["AlgoViz_Desc"]</p>
                        <div class="project-tech">
                            <span>Next.js</span>
                            <span>React</span>
                            <span>TypeScript</span>
                        </div>
                        <div class="project-links">
                            <a href="https://vizualizer.vercel.app" target="_blank" rel="noopener">vizualizer.vercel.app →</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="project-card-new">
                        <h3>CS Visual Lab</h3>
                        <p class="project-desc">@Localizer["CSVisualLab_Desc"]</p>
                        <div class="project-tech">
                            <span>Next.js 14</span>
                            <span>Tailwind</span>
                        </div>
                        <div class="project-links">
                            <a href="https://csvisuallab.vercel.app/" target="_blank" rel="noopener">csvisuallab.vercel.app →</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="project-card-new">
                        <h3>AcademyLogos</h3>
                        <p class="project-desc">@Localizer["AcademyLogos_Desc"]</p>
                        <div class="project-tech">
                            <span>ASP.NET Core</span>
                            <span>EF Core</span>
                        </div>
                        <div class="project-links">
                            <a href="https://academylogos.com" target="_blank" rel="noopener">academylogos.com →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- More on GitHub -->
        <div class="text-start mt-5 pt-4" style="border-top: 1px solid var(--kd-rule);">
            <p class="text-muted mb-3" style="font-family: var(--kd-font-italic); font-size: 1.1rem;">@Localizer["More_Text"]</p>
            <a href="https://github.com/PetrovKunev" target="_blank" rel="noopener" class="btn-outline-light-custom">
                @Localizer["More_GitHub"] →
            </a>
        </div>
    </div>
</section>
