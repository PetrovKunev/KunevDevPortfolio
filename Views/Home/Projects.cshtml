<!-- Custom Styles for Projects -->
<style>
    .text-gradient {
        background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .bg-gradient-primary-to-secondary {
        background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);
    }

    .bg-gradient-secondary-to-primary {
        background: linear-gradient(135deg, var(--bs-secondary) 0%, var(--bs-primary) 100%);
    }

    .bg-gradient-info-to-warning {
        background: linear-gradient(135deg, var(--bs-info) 0%, var(--bs-warning) 100%);
    }

    .bg-gradient-success-to-info {
        background: linear-gradient(135deg, var(--bs-success) 0%, var(--bs-info) 100%);
    }

    .bg-gradient-warning-to-danger {
        background: linear-gradient(135deg, var(--bs-warning) 0%, var(--bs-danger) 100%);
    }

    .bg-gradient-danger-to-primary {
        background: linear-gradient(135deg, var(--bs-danger) 0%, var(--bs-primary) 100%);
    }

    .project-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .project-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }

    .badge {
        font-size: 0.7rem;
        padding: 0.3em 0.6em;
    }

    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }

    .card-body {
        display: flex;
        flex-direction: column;
    }

    .card-body .d-grid {
        margin-top: auto;
    }
</style>