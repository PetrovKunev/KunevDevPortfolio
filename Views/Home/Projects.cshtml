@{
    Layout = "_Layout";
    ViewData["Title"] = "Projects";
}

<!-- Projects Section-->
<section class="py-5">
    <div class="container px-3 px-lg-5 mb-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bolder mb-0">
                <span class="text-gradient d-inline">Projects</span>
            </h1>
            <p class="lead fw-light mb-4">Real-world applications that solve business problems</p>
        </div>
        
        <!-- Projects Grid - 3 Columns -->
        <div class="row g-4">
            
            <!-- SchoolSelect.net Project -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 overflow-hidden shadow rounded-4 border-0 project-card">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <div class="bg-gradient-primary-to-secondary text-white p-3 rounded-3 mb-3">
                                <i class="bi bi-mortarboard-fill" style="font-size: 2.5rem;"></i>
                            </div>
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <h4 class="fw-bolder mb-0 me-2">SchoolSelect.net</h4>
                                <span class="badge bg-success">Live</span>
                            </div>
                        </div>
                        <p class="mb-3 small">
                            Educational platform helping Bulgarian students make informed high school choices.
                            Analyzes student grades and NVO results to recommend the best schools and programs.
                        </p>
                        <div class="mb-3">
                            <span class="badge bg-primary me-1 mb-1">ASP.NET Core</span>
                            <span class="badge bg-primary me-1 mb-1">Entity Framework</span>
                            <span class="badge bg-primary me-1 mb-1">Bootstrap</span>
                            <span class="badge bg-primary me-1 mb-1">SQL Server</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="https://schoolselect.net" target="_blank" class="btn btn-primary btn-sm">
                                <i class="bi bi-globe me-1"></i>Live Demo
                            </a>
                            <a href="#schoolselect-details" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse">
                                <i class="bi bi-info-circle me-1"></i>More Details
                            </a>
                        </div>
                        <div class="collapse mt-3" id="schoolselect-details">
                            <div class="card card-body bg-light">
                                <h6 class="fw-bold">Key Features:</h6>
                                <ul class="mb-2 small">
                                    <li>Grade and NVO score analysis system</li>
                                    <li>School database with real admission data</li>
                                    <li>Personalized school recommendations</li>
                                    <li>Filtering by location, programs, and requirements</li>
                                </ul>
                                <h6 class="fw-bold">Impact:</h6>
                                <p class="mb-0 small">Helps students and parents navigate the complex Bulgarian education system with data-driven insights.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AcademyLogos.com Project -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 overflow-hidden shadow rounded-4 border-0 project-card">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <div class="bg-gradient-success-to-info text-white p-3 rounded-3 mb-3">
                                <i class="bi bi-book-fill" style="font-size: 2.5rem;"></i>
                            </div>
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <h4 class="fw-bolder mb-0 me-2">AcademyLogos.com</h4>
                                <span class="badge bg-success">Live</span>
                            </div>
                        </div>
                        <p class="mb-3 small">
                            Educational platform offering courses for 5th, 6th, and 7th grade students.
                            Specialized in Mathematics, Bulgarian Language and Literature, and Programming.
                        </p>
                        <div class="mb-3">
                            <span class="badge bg-primary me-1 mb-1">ASP.NET Core</span>
                            <span class="badge bg-primary me-1 mb-1">Entity Framework</span>
                            <span class="badge bg-primary me-1 mb-1">TailwindCSS</span>
                            <span class="badge bg-primary me-1 mb-1">MS SQL</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="https://academylogos.com" target="_blank" class="btn btn-primary btn-sm">
                                <i class="bi bi-globe me-1"></i>Live Demo
                            </a>
                            <a href="#academylogos-details" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse">
                                <i class="bi bi-info-circle me-1"></i>More Details
                            </a>
                        </div>
                        <div class="collapse mt-3" id="academylogos-details">
                            <div class="card card-body bg-light">
                                <h6 class="fw-bold">Course Offerings:</h6>
                                <ul class="mb-2 small">
                                    <li>Mathematics for 5th, 6th, and 7th grade</li>
                                    <li>Bulgarian Language and Literature</li>
                                    <li>Programming fundamentals</li>
                                    <li>Interactive learning materials</li>
                                </ul>
                                <h6 class="fw-bold">Target Audience:</h6>
                                <p class="mb-2 small">Middle school students (grades 5-7) looking to strengthen their academic foundation and develop programming skills.</p>
                                <h6 class="fw-bold">Technology Stack:</h6>
                                <p class="mb-0 small">Built with ASP.NET Core, Entity Framework for data management, TailwindCSS for modern responsive design, and MS SQL Server for robust database performance.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Flow.kunev.dev Project -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 overflow-hidden shadow rounded-4 border-0 project-card">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <div class="bg-gradient-info-to-warning text-white p-3 rounded-3 mb-3">
                                <i class="bi bi-lightning-charge-fill" style="font-size: 2.5rem;"></i>
                            </div>
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <h4 class="fw-bolder mb-0 me-2">Flow.kunev.dev</h4>
                                <span class="badge bg-success">Live</span>
                            </div>
                        </div>
                        <p class="mb-3 small">
                            Manage your finances with Flow. Track income and expenses, plan your budget, 
                            and analyze your financial status with the easiest personal finance management application.
                        </p>
                        <div class="mb-3">
                            <span class="badge bg-primary me-1 mb-1">Personal Finance</span>
                            <span class="badge bg-primary me-1 mb-1">Budget Planning</span>
                            <span class="badge bg-primary me-1 mb-1">Expense Tracking</span>
                            <span class="badge bg-primary me-1 mb-1">Financial Analytics</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="https://flow.kunev.dev" target="_blank" class="btn btn-primary btn-sm">
                                <i class="bi bi-globe me-1"></i>Live Demo
                            </a>
                            <a href="#flow-details" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse">
                                <i class="bi bi-info-circle me-1"></i>More Details
                            </a>
                        </div>
                        <div class="collapse mt-3" id="flow-details">
                            <div class="card card-body bg-light">
                                <h6 class="fw-bold">Key Features:</h6>
                                <ul class="mb-2 small">
                                    <li>Income and expense tracking</li>
                                    <li>Budget planning and management</li>
                                    <li>Financial analytics and reports</li>
                                    <li>Transaction categorization</li>
                                </ul>
                                <h6 class="fw-bold">Technology Stack:</h6>
                                <p class="mb-0 small">Modern web application for personal finance management with intuitive interface and powerful analytical capabilities.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- EfficiencyHub Project -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 overflow-hidden shadow rounded-4 border-0 project-card">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <div class="bg-gradient-secondary-to-primary text-white p-3 rounded-3 mb-3">
                                <i class="bi bi-kanban-fill" style="font-size: 2.5rem;"></i>
                            </div>
                            <div class="d-flex align-items-center justify-content-center mb-2">
                                <h4 class="fw-bolder mb-0 me-2">EfficiencyHub</h4>
                                <span class="badge bg-secondary">GitHub</span>
                            </div>
                        </div>
                        <p class="mb-3 small">
                            Comprehensive project and task management application built with ASP.NET Core 8.0.
                            Features user authentication, role-based access control, and administrative dashboard.
                        </p>
                        <div class="mb-3">
                            <span class="badge bg-primary me-1 mb-1">ASP.NET Core 8.0</span>
                            <span class="badge bg-primary me-1 mb-1">Razor Pages</span>
                            <span class="badge bg-primary me-1 mb-1">Identity Framework</span>
                            <span class="badge bg-primary me-1 mb-1">xUnit Testing</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="https://github.com/PetrovKunev/EfficiencyHubApp" target="_blank" class="btn btn-dark btn-sm">
                                <i class="bi bi-github me-1"></i>View Code
                            </a>
                            <a href="#efficiency-details" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse">
                                <i class="bi bi-info-circle me-1"></i>More Details
                            </a>
                        </div>
                        <div class="collapse mt-3" id="efficiency-details">
                            <div class="card card-body bg-light">
                                <h6 class="fw-bold">User Features:</h6>
                                <ul class="mb-2 small">
                                    <li>Create, edit, and delete projects</li>
                                    <li>Task management with due dates and statuses</li>
                                    <li>Automated reminders for deadlines</li>
                                    <li>Personalized dashboard with activity logs</li>
                                </ul>
                                <h6 class="fw-bold">Admin Features:</h6>
                                <ul class="mb-2 small">
                                    <li>User management and role assignment</li>
                                    <li>System-wide analytics and reporting</li>
                                </ul>
                                <h6 class="fw-bold">Technical Highlights:</h6>
                                <p class="mb-0 small">Clean architecture, dependency injection, comprehensive unit testing, and secure authentication system.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Additional Projects Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 rounded-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="card-body p-5 text-center">
                        <h3 class="fw-bolder mb-3">More Projects Coming Soon</h3>
                        <p class="mb-4">I'm constantly working on new projects and expanding my portfolio. Check back regularly for updates!</p>
                        <div class="d-grid gap-2 d-md-flex justify-content-center">
                            <a href="https://github.com/PetrovKunev" target="_blank" class="btn btn-outline-dark">
                                <i class="bi bi-github me-1"></i>View GitHub Profile
                            </a>
                            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary">
                                <i class="bi bi-envelope me-1"></i>Discuss Your Project
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Custom Styles for Projects -->
<style>
    .text-gradient {
        background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .bg-gradient-primary-to-secondary {
        background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-secondary) 100%);
    }

    .bg-gradient-secondary-to-primary {
        background: linear-gradient(135deg, var(--bs-secondary) 0%, var(--bs-primary) 100%);
    }

    .bg-gradient-info-to-warning {
        background: linear-gradient(135deg, var(--bs-info) 0%, var(--bs-warning) 100%);
    }

    .bg-gradient-success-to-info {
        background: linear-gradient(135deg, var(--bs-success) 0%, var(--bs-info) 100%);
    }

    .project-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .project-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }

    .badge {
        font-size: 0.7rem;
        padding: 0.3em 0.6em;
    }

    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }

    .card-body {
        display: flex;
        flex-direction: column;
    }

    .card-body .d-grid {
        margin-top: auto;
    }
</style>