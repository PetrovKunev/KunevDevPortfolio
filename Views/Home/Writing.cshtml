@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["MetaTitle"] = Localizer["Meta_Title"].Value;
    ViewData["MetaDescription"] = Localizer["Meta_Desc"].Value;
}

<section class="section-dark">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 05 · kunev.dev / writing</span>
            <span class="rh-right">@Localizer["RH_Right"]</span>
        </div>

        <div class="row justify-content-start">
            <div class="col-lg-10">
                <div class="section-label">@Localizer["Page_Label"]</div>
                <h1 class="section-heading mb-3">@Localizer["Page_Title"]</h1>
                <p class="section-subtitle mb-5">@Localizer["Page_Subtitle"]</p>

                <div class="writing-toc">
                    <div class="writing-item">
                        <div>
                            <div class="writing-tag">@Localizer["Tag_1"]</div>
                            <h2><a asp-controller="Home" asp-action="KnowledgeRepresentation">@Localizer["Post1_Title"]</a></h2>
                            <p>@Localizer["Post1_Desc"]</p>
                        </div>
                        <a class="writing-read-link" asp-controller="Home" asp-action="KnowledgeRepresentation">@Localizer["Read_Post"]</a>
                    </div>

                    <div class="writing-item">
                        <div>
                            <div class="writing-tag">@Localizer["Tag_2"]</div>
                            <h2>@Localizer["Post2_Title"]</h2>
                            <p>@Localizer["Post2_Desc"]</p>
                        </div>
                        <span class="writing-coming-soon">@Localizer["Coming_Soon"]</span>
                    </div>

                    <div class="writing-item">
                        <div>
                            <div class="writing-tag">@Localizer["Tag_3"]</div>
                            <h2>@Localizer["Post3_Title"]</h2>
                            <p>@Localizer["Post3_Desc"]</p>
                        </div>
                        <span class="writing-coming-soon">@Localizer["Coming_Soon"]</span>
                    </div>
                </div>

                <div class="mt-5 pt-4" style="border-top: 1px solid var(--kd-rule);">
                    <p style="font-family: var(--kd-font-italic); color: var(--kd-muted); font-size: 1.05rem; max-width: 58ch;">@Localizer["Subscribe_Text"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
