@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;
}

<section class="section-dark">
    <div class="container px-3 px-lg-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="section-label">@Localizer["Page_Label"]</div>
                <h1 class="section-heading mb-3">@Localizer["Page_Title"]</h1>
                <p class="section-subtitle mb-5">@Localizer["Page_Subtitle"]</p>

                <div class="writing-item">
                    <div class="writing-tag">@Localizer["Tag_AI"]</div>
                    <h4>@Localizer["Post1_Title"]</h4>
                    <p>@Localizer["Post1_Desc"]</p>
                    <span class="writing-coming-soon">@Localizer["Coming_Soon"]</span>
                </div>

                <div class="writing-item">
                    <div class="writing-tag">@Localizer["Tag_Infra"]</div>
                    <h4>@Localizer["Post2_Title"]</h4>
                    <p>@Localizer["Post2_Desc"]</p>
                    <span class="writing-coming-soon">@Localizer["Coming_Soon"]</span>
                </div>

                <div class="writing-item">
                    <div class="writing-tag">@Localizer["Tag_Research"]</div>
                    <h4>@Localizer["Post3_Title"]</h4>
                    <p>@Localizer["Post3_Desc"]</p>
                    <span class="writing-coming-soon">@Localizer["Coming_Soon"]</span>
                </div>

                <div class="mt-5 pt-4" style="border-top: 1px solid var(--kd-border);">
                    <p style="color: var(--kd-text-muted); font-size: 0.9rem;">@Localizer["Subscribe_Text"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
