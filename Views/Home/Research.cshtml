@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;
}

<section class="section-dark">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 03 · kunev.dev / research</span>
            <span class="rh-right">@Localizer["RH_Right"]</span>
        </div>

        <div class="row justify-content-start">
            <div class="col-lg-9">
                <div class="section-label">@Localizer["Page_Label"]</div>
                <h1 class="section-heading mb-4">@Localizer["Page_Title"]</h1>

                <div class="research-card">
                    <div class="research-status">@Localizer["Status"]</div>
                    <h3>@Localizer["Topic"]</h3>
                    <p class="research-summary dropcap">@Localizer["Summary"]</p>
                    <p class="research-summary">@Localizer["Summary_2"]</p>

                    <blockquote class="pull-quote">
                        An AI tutor should <em>reduce extraneous load</em>, not replace productive struggle.
                    </blockquote>

                    <div class="project-tech" style="padding: 0.8rem 0 0; border-top: 1px solid var(--kd-rule); margin-top: 1.5rem;">
                        <span>Cognitive Load Theory</span>
                        <span>ICAP Framework</span>
                        <span>Intelligent Tutoring Systems</span>
                        <span>LLMs in Education</span>
                    </div>
                </div>

                <div class="mt-5 pt-4" style="border-top: 1px solid var(--kd-rule);">
                    <div class="section-label">Adjacent interests</div>
                    <h3 style="font-family: var(--kd-font-display); font-weight: 500; font-size: 1.6rem; letter-spacing: -0.012em; margin-bottom: 1rem;">@Localizer["Interest_Title"]</h3>
                    <p style="font-family: var(--kd-font-body); color: var(--kd-ink-2); line-height: 1.7; font-size: 1.05rem; max-width: 62ch;">@Localizer["Interest_Text"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
