@inject IViewLocalizer Localizer
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Page_Title"].Value;
}

<section class="section-dark">
    <div class="container px-3 px-lg-5">
        <div class="running-head">
            <span>№ 05 · kunev.dev / consulting</span>
            <span class="rh-right">AI in education · engagements</span>
        </div>

        <div class="row justify-content-start">
            <div class="col-lg-9">
                <div class="section-label">@Localizer["Page_Label"]</div>
                <h1 class="section-heading mb-4">@Localizer["Page_Title"]</h1>
                <p class="section-subtitle mb-5">@Localizer["Page_Intro"]</p>

                <div class="services-list">
                    <div class="service-item">
                        <div class="service-arrow"></div>
                        <div>
                            <h4>@Localizer["Service1_Title"]</h4>
                            <p>@Localizer["Service1_Desc"]</p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="service-arrow"></div>
                        <div>
                            <h4>@Localizer["Service2_Title"]</h4>
                            <p>@Localizer["Service2_Desc"]</p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="service-arrow"></div>
                        <div>
                            <h4>@Localizer["Service3_Title"]</h4>
                            <p>@Localizer["Service3_Desc"]</p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="service-arrow"></div>
                        <div>
                            <h4>@Localizer["Service4_Title"]</h4>
                            <p>@Localizer["Service4_Desc"]</p>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4" style="border-top: 1px solid var(--kd-rule);">
                    <div class="section-label">Next step</div>
                    <h3 style="font-family: var(--kd-font-display); font-weight: 500; font-size: 1.8rem; letter-spacing: -0.015em; margin-bottom: 1rem;">@Localizer["CTA_Title"]</h3>
                    <p style="font-family: var(--kd-font-body); color: var(--kd-ink-2); line-height: 1.65; max-width: 58ch;">@Localizer["CTA_Text"]</p>
                    <a class="btn-accent mt-3 d-inline-flex" asp-controller="Home" asp-action="Contact">
                        @Localizer["CTA_Button"] <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
